{
  "name": "aria",
  "version": "2.0.0-alpha.5",
  "private": false,
  "description": "ARIA: an OpenCode v2 plugin adding a default coding agent, scoped specialists, enforced permission rules, safe per-session scratch, session-owned plans, a read-only git tool, a status report and a TUI plan view. Everything else is native OpenCode.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "files": [
    "src",
    "bin",
    "prompts",
    "skills",
    "README.md",
    "LICENSE",
    "NOTICE",
    "package-lock.json"
  ],
  "bin": {
    "aria": "./bin/aria.mjs"
  },
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.tsx"
  },
  "scripts": {
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "lint": "eslint src bin"
  },
  "dependencies": {
    "ink": "8.0.0",
    "jsonc-parser": "3.3.1",
    "react": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@opentui/core": ">=0.8.4",
    "@opentui/solid": ">=0.8.4",
    "@types/node": "^22.0.0",
    "eslint": "^9.12.0",
    "globals": "^15.0.0",
    "solid-js": ">=1.9.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "@opencode/plugin": "2.3.0",
    "@types/react": "^19.0.0"
  }
}
