node_modules/
dist/*
!dist/*.js
!dist/*.d.ts
*.tsbuildinfo
.opencode/state/
.env
.env.local
*.log
*.tgz
.DS_Store
Thumbs.db
desktop.ini

# Python
__pycache__/
*.py[cod]

/scratch/

# ARIA-controlled runtime state under .aria/: everything ignored except
# Markdown plans, which stay versionable. Plan-scoped and fast-path scratch
# live under .aria/scratch/ and are never versioned.
/.aria/*
!/.aria/
!/.aria/plans/
/.aria/scratch/
